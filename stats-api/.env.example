# Puerto del servidor
PORT=3001

# Conexión a MongoDB Atlas
MONGODB_URI=

# URL del frontend permitida por CORS (además de localhost:5173/4173 y *.vercel.app)
FRONTEND_URL=

# ── Autenticación de administrador ─────────────────────────────
# Usuario admin (texto plano)
ADMIN_USER=admin

# Contraseña admin, como hash bcrypt (NO texto plano)
# Generar con: node -e "console.log(require('bcryptjs').hashSync('tu-password', 10))"
ADMIN_PASSWORD=

# Secreto para firmar los JWT del login (usar un valor largo y aleatorio)
JWT_SECRET=
